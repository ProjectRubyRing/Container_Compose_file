# compose 用のローカル環境変数 (README の手順で .env.example からコピーして作成)
.env

# verify-tls.sh がホスト検証用に named volume から取り出す CA / 証明書
# (pki-init が生成するテスト用証明書。コミットしない)
.pki-out/

# 受領済み自己証明書の投入口。連携された cacert.crt / 秘密鍵はコミットしない
# (README.md と .gitkeep だけを管理対象にする)
compose/pki/provided/*
!compose/pki/provided/README.md
!compose/pki/provided/.gitkeep

# pki-init が書き出す cacert.crt の出力口 (build secret の入力 / provided への配置元)。
# テスト用証明書と CA 秘密鍵が出るためコミットしない
# (README.md と .gitkeep だけを管理対象にする)
compose/pki/export/*
!compose/pki/export/README.md
!compose/pki/export/.gitkeep

# ecs-exec (ECS Exec 偽装) がやり取りするファイルとセッションログ。
# 中身は実行のたびに変わるためコミットしない
# (README.md と .gitkeep だけを管理対象にする)
compose/ecs-exec/files/*
!compose/ecs-exec/files/README.md
!compose/ecs-exec/files/.gitkeep
compose/ecs-exec/sessions/*
!compose/ecs-exec/sessions/README.md
!compose/ecs-exec/sessions/.gitkeep

# Terraform (terraform/ 配下)。.terraform.lock.hcl は再現性のためコミットする
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
