<?xml version="1.0" encoding="UTF-8"?>
<!--
  =============================================================================
  tls-probe — frontend / backend の両方に配備する検証用サーブレット WAR
  ---------------------------------------------------------------------------
  「front/back の JVM が、トラストストアへ取り込んだ自己署名 CA / 自己署名証明書を
   使って HTTPS の REST API を呼び出せるか」を、その JVM 自身から実行して確認する。
  front/back いずれの Dockerfile でも maven ビルドステージでこの WAR を作り、
  ${JBOSS_HOME}/standalone/deployments/tls-probe.war として配備する。
  jakarta.servlet-api は EAP が提供するため scope=provided (WAR には含めない)。
  =============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.tlsprobe</groupId>
    <artifactId>tls-probe</artifactId>
    <version>1.0.0</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>
    </properties>

    <dependencies>
        <!-- Jakarta EE 10 Servlet API。EAP が提供するので WAR には同梱しない -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- 生成される WAR 名 = tls-probe.war (コンテキストは jboss-web.xml で /tls-probe) -->
        <finalName>tls-probe</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>
</project>
